# Cloudflare Pages headers. Verify after deploy with the curl commands in docs/LAUNCH.md.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted build assets (fonts, JS, CSS): cache for a year.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# OG images are not fingerprinted, so "long" = 30 days instead of immutable.
/og/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

# Icons and manifest rarely change.
/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400
/favicon-32.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/icon-*.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/site.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=86400
