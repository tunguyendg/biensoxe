---
import type { GetStaticPaths } from 'astro';
import FeaturedBanner from '../../components/FeaturedBanner.astro';
import OfferCards from '../../components/OfferCards.astro';
import Base from '../../layouts/Base.astro';
import { SHOW_AREA_POPULATION, areaPopulationLine, mergeBadge, metaLine } from '../../lib/card';
import { data } from '../../lib/data';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { crumbsLd, type Crumb } from '../../lib/crumbs';
import { provinceSummary } from '../../lib/content';
import { appendixNameNote } from '../../lib/decisions';
import { lookup } from '../../lib/lookup';
import { mergerSentence, provinceDescription, provinceTitle } from '../../lib/pages';
import { footerHtml } from '../../lib/result-html';
import '../../styles/home.css';
import '../../styles/pages.css';

export const getStaticPaths = (() => data.provinces.map((p) => ({ params: { slug: p.slug }, props: { p } }))) satisfies GetStaticPaths;

const { p } = Astro.props;
const site = Astro.site as URL;
const badge = mergeBadge(p);
const rows = p.codes.flatMap((c) => {
  const r = lookup(c);
  return r.kind === 'province' ? [{ code: c, former: r.former, changed: r.changed }] : [];
});
const nameNote = appendixNameNote(`province:${p.slug}`, p.name, p.codes);
const areaPop = SHOW_AREA_POPULATION ? areaPopulationLine(p) : null;
const crumbs: Crumb[] = [
  { name: 'Trang chủ', path: '/' },
  { name: p.name, path: `/tinh/${p.slug}` },
];
---

<Base title={provinceTitle(p)} description={provinceDescription(p)} path={`/tinh/${p.slug}`} jsonLd={[crumbsLd(crumbs, site)]}>
  <main class="home page">
    <Breadcrumb crumbs={crumbs} />
    <h1>Biển số xe {p.name}</h1>
    <p class="merger">{provinceSummary(p)}</p>
    <p class="merger">{mergerSentence(p)}</p>
    <p class={badge.merged ? 'badge badge--merged' : 'badge'}>{badge.text}</p>
    <p class="meta">{metaLine(p)}</p>
    {nameNote && <p class="meta name-note">{nameNote}</p>}
    {areaPop && <p class="meta">{areaPop}</p>}

    <section aria-labelledby="codes-h">
      <h2 id="codes-h">Các mã biển của {p.name}</h2>
      <ul class="codes">
        {
          rows.map((c) => (
            <li>
              <a href={`/${c.code}`}>
                <strong class="codes__n">{c.code}</strong>
                <span class="codes__t">
                  <b>{p.name}</b>
                  {c.changed && <small>Trước đây: {c.former}</small>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="card-foot" set:html={footerHtml()} />

    <OfferCards placement="tinh" pageKey={p.slug} />

    <FeaturedBanner />
  </main>
</Base>
