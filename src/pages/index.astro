---
import Base from '../layouts/Base.astro';
import FeaturedBanner from '../components/FeaturedBanner.astro';
import OfferCards from '../components/OfferCards.astro';
import ResultCard from '../components/ResultCard.astro';
import { lookup } from '../lib/lookup';
import { SOURCE_NAME } from '../lib/copy';
import { ARTICLE_DOCMA, ARTICLE_SAPNHAP } from '../lib/knowledge';
import { data } from '../lib/data';
import { HOME_DESC, HOME_TITLE } from '../lib/pages';
import { pageGraph } from '../lib/schema';
import '../styles/home.css';

// Codes people most often mix up after the 01/07/2025 mergers. Names come only from the data.
const CONFUSING = ['61', '72', '83', '92', '93', '34'];
const confusing = CONFUSING.flatMap((code) => {
  const r = lookup(code);
  return r.kind === 'province' ? [{ code, name: r.province.name, former: r.former }] : [];
});
const sample = lookup('83');
---

<Base title={HOME_TITLE} description={HOME_DESC} path="/" jsonLd={pageGraph({ site: Astro.site as URL, path: '/', name: HOME_TITLE, description: HOME_DESC })}>
  <main class="home">
    <h1>Biển số xe là tỉnh nào?</h1>

    <form id="search-form" class="search" role="search" action="/bang-ma" method="get">
      <label for="plate-input">Nhập 2 số đầu, hoặc cả biển số</label>
      <input
        id="plate-input"
        name="q"
        type="text"
        inputmode="numeric"
        enterkeyhint="search"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="20"
        placeholder="83 hoặc 83A-123.45"
      />
    </form>

    <ResultCard state={{ kind: 'hint' }} plate="83" ghost>
      <noscript>
        <p class="note">
          Trình duyệt đang tắt JavaScript nên không tra ngay khi gõ được.
          <a href="/bang-ma">Xem bảng mã đầy đủ</a>.
        </p>
      </noscript>
    </ResultCard>

    <section class="about" aria-labelledby="about-h">
      <h2 id="about-h">Tra mã biển số theo 34 tỉnh, thành hiện hành</h2>
      <p>
        Biển Số tra mã biển số xe theo {data.provinces.length} tỉnh, thành hiện hành từ 01/07/2025 và hiện cả tỉnh cũ trước sáp nhập{sample.kind === 'province' && sample.changed ? `: biển ${sample.code} nay là ${sample.province.name}, trước là ${sample.former}` : ''}.
        Dữ liệu lấy từ {SOURCE_NAME}.
        Xem <a href="/bang-ma">bảng biển số xe theo tỉnh thành</a>, bài <a href={ARTICLE_SAPNHAP.path}>{ARTICLE_SAPNHAP.h1.toLowerCase()}</a> hoặc bài <a href={ARTICLE_DOCMA.path}>{ARTICLE_DOCMA.h1.toLowerCase()}</a>.
      </p>
    </section>

    <OfferCards placement="result" pageKey="home" />

    <section class="confusing" aria-labelledby="confusing-h">
      <h2 id="confusing-h">Các mã hay bị nhầm sau sáp nhập</h2>
      <ul>
        {
          confusing.map((c) => (
            <li>
              <a href={`/${c.code}`}>
                <strong class="confusing__code">{c.code}</strong>
                <span>
                  {c.name}
                  <small>Trước đây: {c.former}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p><a class="more" href="/bang-ma">Xem bảng mã đầy đủ →</a></p>
    </section>
    <FeaturedBanner />
  </main>

  <script>
    import '../scripts/search';
  </script>
</Base>
