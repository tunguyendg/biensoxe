---
import type { GetStaticPaths } from 'astro';
import FeaturedBanner from '../components/FeaturedBanner.astro';
import OfferCards from '../components/OfferCards.astro';
import ResultCard from '../components/ResultCard.astro';
import Base from '../layouts/Base.astro';
import { data } from '../lib/data';
import Breadcrumb from '../components/Breadcrumb.astro';
import type { Crumb } from '../lib/crumbs';
import { pageGraph } from '../lib/schema';
import { ARTICLE_BANGDOICHIEU } from '../lib/knowledge';
import { appendixNameNote } from '../lib/decisions';
import { lookup } from '../lib/lookup';
import { codeFacts, specialAnswer } from '../lib/content';
import { SOURCE_DOCS } from '../lib/content';
import { codeDescription, codeExplanation, codeTitle } from '../lib/pages';
import '../styles/home.css';
import '../styles/pages.css';

export const getStaticPaths = (() => data.codes.map((c) => ({ params: { code: c.code } }))) satisfies GetStaticPaths;

const { code } = Astro.params;
const r = lookup(code as string);
if (r.kind === 'unknown') throw new Error(`No page for unknown code ${code}`); // never generated
const nameNote = r.kind === 'province' ? appendixNameNote(`code:${r.code}`, r.province.name, [r.code]) : null;
const facts = r.kind === 'province' ? codeFacts(r) : [];
const answer = r.kind === 'special' ? specialAnswer(r.code) : null;
const site = Astro.site as URL;
const crumbs: Crumb[] = [
  { name: 'Trang chủ', path: '/' },
  ...(r.kind === 'province' ? [{ name: r.province.name, path: `/tinh/${r.province.slug}` }] : []),
  { name: `Biển số ${r.code}`, path: `/${r.code}` },
];
---

<Base
  title={codeTitle(r)}
  description={codeDescription(r)}
  path={`/${r.code}`}
  ogImage={`/og/${r.code}.png`}
  jsonLd={pageGraph({ site, path: `/${r.code}`, name: codeTitle(r), description: codeDescription(r), crumbs })}
>
  <main class="home page">
    <Breadcrumb crumbs={crumbs} />
    <h1>{r.kind === 'province' ? `Biển số ${r.code} là tỉnh nào?` : `Biển số ${r.code} là mã gì?`}</h1>

    {answer && <p class="answer">{answer}</p>}

    <ResultCard state={{ kind: 'result', result: r }} plate={r.code} />

    {facts.length > 0 && <p class="facts">{facts.join(' ')}</p>}
    {
      answer && (
        <p class="facts">
          Nguồn: {SOURCE_DOCS[0]?.name.replace(/ \(.*\)$/, '')} —{' '}
          {SOURCE_DOCS[0]?.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.url} rel="noopener noreferrer">{l.label}</a></>)}.
        </p>
      )
    }

    {nameNote && <p class="meta name-note">{nameNote}</p>}

    <OfferCards placement="result" pageKey={r.code} />

    <section class="explain" aria-labelledby="explain-h">
      <h2 id="explain-h">Giải thích ngắn</h2>
      <p>{codeExplanation(r)}</p>
      <p class="links">
        {r.kind === 'province' && <a href={`/tinh/${r.province.slug}`}>Tất cả mã của {r.province.name}</a>}
        {r.kind === 'province' && r.changed && <a href={`${ARTICLE_BANGDOICHIEU.path}#${r.province.slug}`}>Đối chiếu tỉnh cũ và tỉnh mới</a>}
        <a href="/">Tra mã khác</a>
        <a href="/bang-ma">Bảng mã đầy đủ</a>
      </p>
    </section>

    <FeaturedBanner />
  </main>

  <script>
    import '../scripts/share';
  </script>
</Base>
