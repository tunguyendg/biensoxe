---
import Breadcrumb from '../components/Breadcrumb.astro';
import Base from '../layouts/Base.astro';
import { FORMER_COUNT } from '../lib/content';
import { LIMITS, SOURCE_NAME } from '../lib/copy';
import { formatDate } from '../lib/format';
import { BANGMA_DESC, BANGMA_H1, BANGMA_TITLE } from '../lib/pages';
import { data } from '../lib/data';
import { foldText } from '../lib/format';
import { footerHtml } from '../lib/result-html';
import { lookup } from '../lib/lookup';
import { ARTICLE_BANGDOICHIEU, ARTICLE_NHIEUMA } from '../lib/knowledge';
import { itemListNode, pageGraph } from '../lib/schema';
import type { Crumb } from '../lib/crumbs';
import '../styles/home.css';
import '../styles/pages.css';

// Built only from the data file. Rows are sorted by code inside each region.
const REGIONS = [
  { key: 'bac', label: 'Miền Bắc' },
  { key: 'trung', label: 'Miền Trung & Tây Nguyên' },
  { key: 'nam', label: 'Miền Nam' },
] as const;

const rows = data.codes.flatMap((c) => {
  const r = lookup(c.code);
  if (r.kind === 'province') {
    return [{ code: c.code, region: r.province.region as string, name: r.province.name, former: r.changed ? r.former : null }];
  }
  if (r.kind === 'special') return [{ code: c.code, region: 'dac-biet', name: r.label, former: null }];
  return [];
});
const groups = [
  ...REGIONS.map((g) => ({ key: g.key as string, label: g.label })),
  { key: 'dac-biet', label: 'Mã đặc biệt' },
]
  .map((g) => ({ ...g, rows: rows.filter((r) => r.region === g.key).sort((a, b) => a.code.localeCompare(b.code)) }))
  .filter((g) => g.rows.length > 0);
const site = Astro.site as URL;
const crumbs: Crumb[] = [{ name: 'Trang chủ', path: '/' }, { name: 'Bảng mã', path: '/bang-ma' }];
const listId = `${new URL('/bang-ma', site).href}#itemlist`;
const graph = pageGraph({
  site,
  path: '/bang-ma',
  type: 'CollectionPage',
  name: BANGMA_TITLE,
  description: BANGMA_DESC,
  crumbs,
  mainEntityId: listId,
  // Same order as the "Tra theo tỉnh, thành" list shown on the page.
  extra: [itemListNode(listId, data.provinces.map((p) => ({ name: p.name, path: `/tinh/${p.slug}` })), site)],
});
---

<Base title={BANGMA_TITLE} description={BANGMA_DESC} path="/bang-ma" jsonLd={graph}>
  <main class="home page">
    <Breadcrumb crumbs={crumbs} />
    <h1>{BANGMA_H1}</h1>
    <p class="intro">
      Bảng gồm {data.codes.length} mã biển số xe của {data.provinces.length} tỉnh, thành hiện hành, theo {SOURCE_NAME}, hiệu lực từ {formatDate(data.meta.dataVersion)}.
      Mỗi mã kèm tỉnh trước sáp nhập (trong {FORMER_COUNT} đơn vị cũ) khi có thay đổi. Mã 80 là ký hiệu của Cục Cảnh sát giao thông, không thuộc tỉnh nào.
    </p>
    <section aria-labelledby="howto-h" class="howto">
      <h2 id="howto-h">Cách dùng bảng</h2>
      <ol>
        <li>Gõ mã hoặc tên tỉnh vào ô lọc, hoặc tìm mã theo vùng bên dưới.</li>
        <li>Bấm mã để xem tỉnh hiện hành, tỉnh cũ và các mã khác cùng tỉnh. Cuối trang có danh sách tỉnh, thành để mở trang riêng của từng tỉnh.</li>
        <li>Đọc kỹ giới hạn: {LIMITS}</li>
      </ol>
    </section>

    <p class="intro">
      Tra theo tỉnh cũ: <a href={ARTICLE_BANGDOICHIEU.path}>{ARTICLE_BANGDOICHIEU.h1.toLowerCase()}</a>. Tỉnh có nhiều mã: <a href={ARTICLE_NHIEUMA.path}>{ARTICLE_NHIEUMA.h1.toLowerCase()}</a>.
    </p>

    <form class="filter search" role="search" onsubmit="return false">
      <label for="filter-input">Lọc theo mã hoặc tên tỉnh</label>
      <input id="filter-input" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" maxlength="20" placeholder="83 hoặc Cần Thơ" />
      <p id="filter-count" class="meta" role="status"></p>
    </form>
    <p id="filter-empty" class="note note--info" hidden>Không có mã nào khớp. Thử gõ 2 số đầu hoặc tên tỉnh khác.</p>

    {
      groups.map((g) => (
        <section class="region" data-group aria-labelledby={`h-${g.key}`}>
          <h2 id={`h-${g.key}`}>{g.label}</h2>
          <ul class="codes">
            {g.rows.map((r) => (
              <li data-q={foldText(`${r.code} ${r.name} ${r.former ?? ''}`)} data-code={r.code}>
                <a href={`/${r.code}`}>
                  <strong class="codes__n">{r.code}</strong>
                  <span class="codes__t">
                    <b>{r.name}</b>
                    {r.former && <small>Trước đây: {r.former}</small>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="region" aria-labelledby="h-tinh">
      <h2 id="h-tinh">Tra theo tỉnh, thành</h2>
      <ul class="chips">
        {data.provinces.map((p) => <li><a class="chip chip--wide" href={`/tinh/${p.slug}`}>{p.name}</a></li>)}
      </ul>
    </section>

    <div class="card-foot" set:html={footerHtml()} />
  </main>

  <script>
    import '../scripts/bang-ma';
  </script>
</Base>
