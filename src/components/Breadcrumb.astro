---
import type { Crumb } from '../lib/crumbs';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const last = crumbs.length - 1;
---

<nav class="crumbs" aria-label="Đường dẫn">
  {
    crumbs.map((c, i) => (
      <>
        {i > 0 && ' › '}
        {i < last ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </>
    ))
  }
</nav>
