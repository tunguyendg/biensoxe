---
import { SOURCE_DOCS, type SourceDoc } from '../lib/content';

interface Props {
  docs?: SourceDoc[] | undefined;
}
const { docs = SOURCE_DOCS } = Astro.props;
---

<section aria-labelledby="sources-h" class="sources">
  <h2 id="sources-h">Nguồn</h2>
  <ul>
    {
      docs.map((d) => (
        <li>
          {d.name}{d.clause ? `, ${d.clause}` : ''}.{' '}
          {d.links.map((l, i) => (
            <>
              {i > 0 && ' · '}
              <a href={l.url} rel="noopener noreferrer">{l.label}</a>
            </>
          ))}
        </li>
      ))
    }
  </ul>
</section>
