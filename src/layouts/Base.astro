---
import { data, isDraft } from '../lib/data';
import { formatDate } from '../lib/format';
import { ldString, type JsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description?: string;
  /** Path used for canonical/og:url, e.g. "/83". */
  path?: string;
  /** Path of the OG image; defaults to the generic one. */
  ogImage?: string;
  jsonLd?: JsonLd[];
}
const {
  title,
  description = 'Gõ 2 số đầu của biển để biết xe đăng ký ở tỉnh/thành nào sau sáp nhập 01/07/2025, và tỉnh trước đây.',
  path = Astro.url.pathname,
  ogImage = '/og/default.png',
  jsonLd = [],
} = Astro.props;
const draft = isDraft();
const canonical = new URL(path, Astro.site).href;
const image = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={draft ? 'noindex,follow' : 'index,follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BIEN SO" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={ldString(ld)} />)}
    <noscript><style>.share, .filter { display: none; }</style></noscript>
  </head>
  <body>
    {
      draft && (
        <div class="draft-banner" role="status">
          DỮ LIỆU NHÁP — chưa được kiểm chứng với văn bản chính thức.
        </div>
      )
    }
    <slot />
    <footer>
      <nav aria-label="Liên kết chân trang">
        <a href="/">Tra cứu</a> · <a href="/bang-ma">Bảng mã</a> · <a href="/nguon">Nguồn &amp; giới hạn</a>
      </nav>
      <p>Trang web độc lập, không phải trang của cơ quan nhà nước.</p>
      <p>Bảng mã hiệu lực từ {formatDate(data.meta.dataVersion)}</p>
      <p>Kiểm tra lần cuối {formatDate(data.meta.lastReviewed)}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f6fa;
    --card: #fff;
    --fg: #14213d;
    --muted: #4d5870;
    --accent: #0b57d0;
    --border: #d5dae4;
    --border-strong: #8b95ab;
    --info-bg: #e8effb;
    --offer-bg: #efeee9;
    --warn-bg: #b00020;
    --warn-fg: #fff;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: var(--bg);
    color: var(--fg);
  }
  .draft-banner {
    background: var(--warn-bg);
    color: var(--warn-fg);
    font-weight: 700;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    text-align: center;
  }
  footer {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  footer p {
    margin: 0.25rem 0;
  }
  footer nav a {
    display: inline-block;
    min-height: 2.75rem;
    line-height: 2.75rem;
    color: var(--accent);
    font-weight: 600;
  }
</style>
