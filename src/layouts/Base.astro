---
import { data, isDraft } from '../lib/data';
import { formatDate } from '../lib/format';

interface Props {
  title: string;
}
const { title } = Astro.props;
const draft = isDraft();
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content={draft ? 'noindex' : 'index,follow'} />
  </head>
  <body>
    {
      draft && (
        <div class="draft-banner" role="status">
          DỮ LIỆU NHÁP — chưa được kiểm chứng với văn bản chính thức.
        </div>
      )
    }
    <slot />
    <footer>
      <p>Trang web độc lập, không phải trang của cơ quan nhà nước.</p>
      <p>Bảng mã hiệu lực từ {formatDate(data.meta.dataVersion)}</p>
      <p>Kiểm tra lần cuối {formatDate(data.meta.lastReviewed)}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f6fa;
    --card: #fff;
    --fg: #14213d;
    --muted: #4d5870;
    --accent: #0b57d0;
    --border: #d5dae4;
    --border-strong: #8b95ab;
    --info-bg: #e8effb;
    --warn-bg: #b00020;
    --warn-fg: #fff;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: var(--bg);
    color: var(--fg);
  }
  .draft-banner {
    background: var(--warn-bg);
    color: var(--warn-fg);
    font-weight: 700;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    text-align: center;
  }
  footer {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  footer p {
    margin: 0.25rem 0;
  }
</style>
