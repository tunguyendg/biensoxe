---
import { data, isDraft } from '../lib/data';

interface Props {
  title: string;
}
const { title } = Astro.props;
const draft = isDraft();
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content={draft ? 'noindex' : 'index,follow'} />
  </head>
  <body>
    {
      draft && (
        <div class="draft-banner" role="status">
          DỮ LIỆU NHÁP — chưa được kiểm chứng với văn bản chính thức.
        </div>
      )
    }
    <slot />
    <footer>
      <p>Trang web độc lập, không phải trang của cơ quan nhà nước.</p>
      <p>Dữ liệu cập nhật: {data.meta.lastReviewed.split('-').reverse().join('/')}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fff;
    --fg: #14213d;
    --warn-bg: #b00020;
    --warn-fg: #fff;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: var(--bg);
    color: var(--fg);
  }
  .draft-banner {
    background: var(--warn-bg);
    color: var(--warn-fg);
    font-weight: 700;
    padding: 0.75rem 1rem;
    text-align: center;
  }
  footer {
    padding: 1rem;
  }
</style>
