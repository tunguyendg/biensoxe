---
import { data, isDraft, robotsContent } from '../lib/data';
import { formatDate } from '../lib/format';
import { analyticsScript } from '../lib/analytics';
import { ldString, type JsonLd } from '../lib/jsonld';
import latin700 from '../assets/fonts/be-vietnam-pro-latin-700-normal.woff2?url';
import vietnamese700 from '../assets/fonts/be-vietnam-pro-vietnamese-700-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  /** Path used for canonical/og:url, e.g. "/83". */
  path?: string;
  /** Path of the OG image; defaults to the generic one. */
  ogImage?: string;
  jsonLd?: JsonLd[];
  /** Utility pages (404) are never indexed and have no canonical. */
  noindex?: boolean;
}
const {
  title,
  description = 'Gõ 2 số đầu của biển để biết xe đăng ký ở tỉnh/thành nào sau sáp nhập 01/07/2025, và tỉnh trước đây.',
  path = Astro.url.pathname,
  ogImage = '/og/default.png',
  jsonLd = [],
  noindex = false,
} = Astro.props;
const draft = isDraft();
const analytics = analyticsScript(import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN);
const canonical = new URL(path, Astro.site).href;
const image = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1D4ED8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1F4D" media="(prefers-color-scheme: dark)" />
    {/* Favicon v2 (?v=2 busts old browser caches). Order: svg → png 32 → png 16 → ico. */}
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=2" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png?v=2" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Only the weight used for province names (700), latin + vietnamese subsets. */}
    <link rel="preload" href={latin700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={vietnamese700} as="font" type="font/woff2" crossorigin />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex,follow' : robotsContent(draft)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BIEN SO" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={ldString(ld)} />)}
    <noscript><style>.share, .filter { display: none; }</style></noscript>
  </head>
  <body>
    <header class="site-head">
      <a class="brand" href="/" aria-label="Biển Số – Tra cứu mã biển số xe">
        <img class="brand__mark" src="/brand/logo-mark.svg" alt="" width="40" height="40" />
        <span class="brand__text">
          <span class="brand__name">Biển Số</span>
          <span class="brand__tag">Tra cứu mã biển số xe</span>
        </span>
      </a>
    </header>
    <slot />
    <footer>
      <nav aria-label="Liên kết chân trang">
        <a href="/">Tra cứu</a> · <a href="/bang-ma">Bảng mã</a> · <a href="/kien-thuc">Kiến thức</a> · <a href="/nguon">Nguồn &amp; giới hạn</a>
      </nav>
      <p>Trang web độc lập, không phải trang của cơ quan nhà nước.</p>
      <p>Bảng mã hiệu lực từ {formatDate(data.meta.dataVersion)}</p>
      <p>Kiểm tra lần cuối {formatDate(data.meta.lastReviewed)}</p>
    </footer>
    {analytics && <script is:inline defer src={analytics.src} data-cf-beacon={analytics.beacon} />}
  </body>
</html>
